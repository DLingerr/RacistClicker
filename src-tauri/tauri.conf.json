{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RacistClicker",
  "version": "1.0.0",
  "identifier": "RacistClicker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run frontend:build",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-redist.ps1",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost http: https: data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost http: https: data: blob:; font-src 'self' data:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": []
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DLingerr/RacistClicker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RURFMDE4RjhFMjZBQ0MKUldUTWF1TDRHT0R0aDdWQ2dLQmpVUTRJR1QvL0x3eUwwY2F5S1V2OWFpTWR1NHZvRjRMb05sY1MK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "DLingerr",
    "copyright": "Copyright (c) DLingerr",
    "category": "Utility",
    "shortDescription": "Configurable auto clicker with accurate CPS timing.",
    "longDescription": "Performance-focused auto clicker with global hotkeys, optional overlay, and advanced timing.",
    "homepage": "https://github.com/DLingerr/RacistClicker",
    "resources": {
      "resources/*": ""
    },
    "icon": [
      "icons/icon-deactivated-dark.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installerIcon": "icons/icon-deactivated-dark.ico"
      }
    }
  }
}
